DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV="production"
CORS_ORIGIN="https://your-frontend.onrender.com"

# Trendyol API
TRENDYOL_BASE_URL="https://apigw.trendyol.com/integration"
TRENDYOL_STAGE_URL="https://stageapigw.trendyol.com/integration"

# ModulPOS AI Content Intelligence (optional; the module is OFF unless CONTENT_DATABASE_URL is set). See content/README.md
# Its OWN Postgres database (a separate Supabase project), never the ModulPOS one. Use the direct/session connection (port 5432), not the pgbouncer one.
CONTENT_DATABASE_URL=""
CONTENT_DB_SCHEMA="content"    # its own schema (must exist, see content/README.md): Supabase exposes `public` through its REST API, the content tables must not be there
CONTENT_ENCRYPTION_KEY=""      # 64 hex characters (openssl rand -hex 32); encrypts API keys. Losing it makes saved keys unreadable.
CONTENT_SETUP_TOKEN=""         # one-time secret for creating the first administrator at https://content.modulpos.com ; remove after setup
CONTENT_ADMIN_ORIGINS="https://content.modulpos.com"   # comma separated browser origins allowed to call /api/content
# CONTENT_TIMEZONE="Europe/Istanbul"   # day boundary of the daily limits
# CONTENT_DISABLED=1                   # kill switch
